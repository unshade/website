---
import "@styles/global.css"
import BaseHead, { type ArticleMeta } from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import { SITE } from "@consts"
import { getCurrentLang } from "@i18n/ui"

interface Props {
  title: string
  description: string
  // Use the title as-is instead of appending " | <site name>" (homepage).
  rawTitle?: boolean
  article?: ArticleMeta
}

const { title, description, rawTitle = false, article } = Astro.props

const lang = getCurrentLang(Astro.currentLocale)
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={rawTitle ? title : `${title} | ${SITE.TITLE}`}
      description={description}
      article={article}
    />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
