---
import { type CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"
import { getCurrentLang, localizePath, useTranslations } from "@i18n/ui"

interface Props {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"music">
    | CollectionEntry<"hiking">
}

const { entry } = Astro.props
const { title, summary, date, tags } = entry.data

const lang = getCurrentLang(Astro.currentLocale)
const t = useTranslations(lang)
const article = {
  type: entry.collection === "blog" ? "BlogPosting" : "Article",
  headline: title,
  published: date,
  tags,
  section: {
    name: t(`page.${entry.collection}.title`),
    url: new URL(localizePath(lang, `/${entry.collection}/`), Astro.site).href,
  },
} as const
---

<PageLayout title={title} description={summary} article={article}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={entry} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={entry} />
    </div>
  </BottomLayout>
</PageLayout>
