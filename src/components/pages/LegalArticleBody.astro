---
import { render, type CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate, isoDate } from "@lib/utils"
import { useTranslations, getCurrentLang } from "@i18n/ui"

interface Props {
  doc: CollectionEntry<"legal">
}

const { doc } = Astro.props
const { title, date } = doc.data
const { Content } = await render(doc)

const lang = getCurrentLang(Astro.currentLocale)
const t = useTranslations(lang)
---

<PageLayout title={title} description={t("legal.description", { title })}>
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading">
        {title}
      </h1>
      <p class="font-normal opacity-75">
        {t("legal.lastUpdated")} <time datetime={isoDate(date)}>{formatDate(date, lang)}</time>
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate [&_h2]:text-base [&_h2]:mt-6 [&_h2]:mb-2">
      <Content />
    </article>
  </BottomLayout>
</PageLayout>
