---
// Day sky (sun + planes) and night sky (moon + stars + shooting stars).
// Pure CSS/SVG, no client JS - toggled by the existing light/dark class
// on <html>, same as the rest of the theme.

const stars = Array.from({ length: 45 }, () => ({
  top: Math.round(Math.random() * 70), // keep stars in the upper sky
  left: Math.round(Math.random() * 100),
  size: Math.random() < 0.15 ? 2.5 : 1.4,
  delay: (Math.random() * 5).toFixed(2),
  duration: (3 + Math.random() * 3).toFixed(2),
}))

const shootingStars = [
  { top: 12, left: 70, delay: 0 },
  { top: 22, left: 30, delay: 4.5 },
  { top: 8, left: 50, delay: 9 },
]

// Kept clear of the sun/moon (right-[15%] top-[12-14%]).
const clouds = [
  { top: 17, left: 5, width: "9rem", opacity: 0.9 },
  { top: 8, left: 34, width: "7rem", opacity: 0.75 },
  { top: 27, left: 56, width: "6rem", opacity: 0.6 },
]

const cloudPath = "M8 34 Q6 22 20 20 Q24 8 40 12 Q52 2 64 12 Q80 10 82 24 Q94 26 92 36 Q94 46 80 46 L18 46 Q4 46 8 34 Z"
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- ===== DAY ===== -->
  <div class="block dark:hidden absolute inset-0">
    <!-- Sun -->
    <div class="absolute right-[15%] top-[14%] size-20 md:size-28 rounded-full bg-gradient-to-br from-[#fde8b6] to-[#f3c26b] shadow-[0_0_90px_30px_rgba(243,194,107,0.35)]"></div>

    <!-- Clouds -->
    {clouds.map((c) => (
      <svg
        viewBox="0 0 100 50"
        style={`top:${c.top}%; left:${c.left}%; width:${c.width}; opacity:${c.opacity}; filter: drop-shadow(0 4px 5px rgba(11,15,19,0.10));`}
        class="absolute h-auto"
      >
        <path d={cloudPath} class="fill-white stroke-black/10" stroke-width="1" />
      </svg>
    ))}

    <!-- Planes -->
    <div class="absolute top-[22%] left-0 opacity-0 animate-fly" style="animation-duration: 34s;">
      <div class="flex items-center">
        <div class="w-14 h-px bg-gradient-to-r from-transparent to-black/30 dark:to-white/30"></div>
        <svg viewBox="0 0 24 24" class="w-4 h-4 rotate-90 fill-black/55 dark:fill-white/55 shrink-0">
          <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13 19v-5.5l8 2.5z"/>
        </svg>
      </div>
    </div>
    <div class="absolute top-[34%] left-0 opacity-0 animate-fly" style="animation-duration: 46s; animation-delay: 12s;">
      <div class="flex items-center">
        <div class="w-10 h-px bg-gradient-to-r from-transparent to-black/20 dark:to-white/20"></div>
        <svg viewBox="0 0 24 24" class="w-3 h-3 rotate-90 fill-black/40 dark:fill-white/40 shrink-0">
          <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13 19v-5.5l8 2.5z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- ===== NIGHT ===== -->
  <div class="hidden dark:block absolute inset-0">
    <!-- Moon -->
    <div class="absolute right-[15%] top-[12%] size-16 md:size-24 rounded-full bg-ice-100 shadow-[0_0_60px_18px_rgba(238,243,244,0.25)] overflow-hidden">
      <div class="absolute size-3 rounded-full bg-black/10 top-3 left-4"></div>
      <div class="absolute size-2 rounded-full bg-black/10 top-8 left-9"></div>
      <div class="absolute size-4 rounded-full bg-black/10 top-4 left-10"></div>
    </div>

    <!-- Clouds - a shade lighter than the sky so they read as a shape and
         dim the stars behind them, rather than blending invisibly into bg-black -->
    {clouds.map((c) => (
      <svg
        viewBox="0 0 100 50"
        style={`top:${c.top}%; left:${c.left}%; width:${c.width}; opacity:${c.opacity * 0.7};`}
        class="absolute h-auto z-10"
      >
        <path d={cloudPath} class="fill-[#232c35]" />
      </svg>
    ))}

    <!-- Stars -->
    {stars.map((s) => (
      <span
        class="absolute rounded-full bg-white animate-twinkle"
        style={`top:${s.top}%; left:${s.left}%; width:${s.size}px; height:${s.size}px; animation-delay:${s.delay}s; animation-duration:${s.duration}s;`}
      />
    ))}

    <!-- Shooting stars -->
    {shootingStars.map((m) => (
      <span
        class="absolute h-px w-24 rounded-full bg-gradient-to-r from-transparent via-white to-transparent opacity-0 animate-shoot"
        style={`top:${m.top}%; left:${m.left}%; animation-delay:${m.delay}s; animation-duration:7s;`}
      />
    ))}
  </div>
</div>
