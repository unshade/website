---
type Props = {
  text: string
  icon: string
  href: string
}

const { text, icon, href } = Astro.props
---

<a href={href} target="_blank" class="w-fit px-3 py-2 group rounded border flex gap-2 items-center border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 blend">
  <svg height={20} width={20}>
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-sm font-mono capitalize text-black/60 dark:text-white/60 group-hover:text-black group-hover:dark:text-white blend">
    {text}
  </span>
</a>