---
// Layered mountain silhouette (static - a subtle sway looked good in
// principle but even GPU-promoted it re-rasterized the large paths every
// frame and stepped visibly, so the ridges just hold still) + a soft
// "alpenglow" behind the peaks, plus a small chairlift climbing the front
// slope. Pure SVG/CSS, no canvas/JS - the lift respects prefers-reduced-motion
// via .animate-liftChair in tailwind.config.mjs.
---

<!-- Alpenglow - sits in its own unclipped layer so the blur can fade out
     freely instead of being cut off by the ridge band's overflow-hidden. -->
<div class="pointer-events-none absolute inset-x-0 bottom-0 h-full" aria-hidden="true">
  <div class="absolute left-1/2 bottom-[15%] -translate-x-1/2 w-[80vw] max-w-[900px] aspect-square rounded-full blur-3xl opacity-40 dark:opacity-30 bg-gradient-to-t from-ice-400/40 via-moss-300/10 to-transparent dark:from-ice-500/30 dark:via-ice-700/10"></div>
</div>

<div class="pointer-events-none absolute inset-x-0 bottom-0 h-[55vh] min-h-[320px] overflow-hidden" aria-hidden="true">
  <!-- Distant massif (Mont Blanc) - farthest layer, so it's taller and
       smoother than the near ridges, and much fainter to read as haze. -->
  <svg class="absolute bottom-0 w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
    <path d="M400 320 L400 250 Q480 170 560 175 Q620 120 690 60 Q715 45 740 65 Q790 110 850 190 Q900 230 980 235 L980 320 Z" class="fill-black/[0.11] dark:fill-white/[0.09] stroke-black/10 dark:stroke-white/10" stroke-width="2" stroke-linejoin="round" />
    <path d="M655 92 L690 60 L715 45 L740 65 L716 80 L688 96 Z" class="fill-white/80 dark:fill-white/20 stroke-black/10 dark:stroke-none" stroke-width="1" stroke-linejoin="round" />
  </svg>

  <!-- Back ridge -->
  <svg class="absolute bottom-0 w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
    <path d="M0 260 L120 190 L240 230 L360 140 L480 210 L620 120 L760 200 L900 150 L1040 220 L1180 160 L1320 210 L1440 180 L1440 320 L0 320 Z" class="fill-black/10 dark:fill-white/10" />
  </svg>

  <!-- Mid ridge -->
  <svg class="absolute bottom-0 w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
    <path d="M0 300 L100 240 L220 270 L340 180 L460 250 L560 160 L680 240 L820 170 L940 240 L1080 190 L1200 250 L1320 210 L1440 240 L1440 320 L0 320 Z" class="fill-black/20 dark:fill-white/[0.14]" />
  </svg>

  <!-- Front ridge -->
  <svg class="absolute bottom-0 w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
    <path d="M0 320 L0 280 L140 210 L260 250 L400 170 L520 230 L660 150 L780 220 L920 160 L1040 230 L1180 180 L1300 230 L1440 200 L1440 320 Z" class="fill-white dark:fill-black" />
  </svg>

  <!-- Ski lift, climbing the front slope between its two peaks -->
  <svg class="absolute bottom-0 w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
    <g class="stroke-black/40 dark:stroke-white/40" stroke-width="2" stroke-linecap="round">
      <!-- cable -->
      <line x1="1040" y1="182" x2="1180" y2="132" />
      <!-- pylons (base + top stations a little taller than the two mid pylons) -->
      <line x1="1040" y1="230" x2="1040" y2="182" stroke-width="3" />
      <line x1="1030" y1="184" x2="1050" y2="184" />
      <line x1="1090" y1="212" x2="1090" y2="164" />
      <line x1="1082" y1="166" x2="1098" y2="166" />
      <line x1="1140" y1="194" x2="1140" y2="146" />
      <line x1="1132" y1="148" x2="1148" y2="148" />
      <line x1="1180" y1="180" x2="1180" y2="132" stroke-width="3" />
      <line x1="1170" y1="134" x2="1190" y2="134" />
    </g>

    <!-- chairs, sliding up the cable on a loop. Base position is a plain
         SVG transform attribute on the outer <g>; the CSS animation only
         ever touches the inner <g>'s transform - mixing the two on one
         element makes the animation silently discard the static offset. -->
    <g transform="translate(1040 182)">
      <g class="animate-liftChair" style="animation-duration: 7s;">
        <line x1="0" y1="0" x2="0" y2="12" class="stroke-black/40 dark:stroke-white/40" stroke-width="1.5" />
        <rect x="-5" y="12" width="10" height="6" rx="1.5" class="fill-ice-600/70 dark:fill-ice-300/70" />
      </g>
    </g>
    <g transform="translate(1040 182)">
      <g class="animate-liftChair" style="animation-duration: 7s; animation-delay: -3.5s;">
        <line x1="0" y1="0" x2="0" y2="12" class="stroke-black/40 dark:stroke-white/40" stroke-width="1.5" />
        <rect x="-5" y="12" width="10" height="6" rx="1.5" class="fill-ice-600/70 dark:fill-ice-300/70" />
      </g>
    </g>
  </svg>
</div>
