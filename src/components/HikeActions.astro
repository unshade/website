---
import { useTranslations, getCurrentLang } from "@i18n/ui"

type Props = { slug: string }

const { slug } = Astro.props
const t = useTranslations(getCurrentLang(Astro.currentLocale))
---

<div class="mt-8 mb-2">
  <a
    href={`/gpx/${slug}.gpx`}
    download
    class="inline-block px-3 py-1.5 text-sm border rounded border-black/15 dark:border-white/20 hover:bg-black/5 hover:dark:bg-white/10 hover:text-black hover:dark:text-white blend"
  >
    {t("hike.downloadGpx")}
  </a>
</div>
<p class="text-xs text-black/50 dark:text-white/50 mb-8">{t("hike.gpxHint")}</p>
