---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import SearchCollection from "@components/SearchCollection";
import { HIKING } from "@consts";

const trails = (await getCollection("hiking"))
  .filter((trail) => !trail.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [...new Set(trails.flatMap((trail) => trail.data.tags))].sort(
  (a, b) => a.localeCompare(b),
);

const estimated_initial_size =
  28 + trails.length * 158 + (trails.length - 1) * 12;
---

<PageLayout title={HIKING.TITLE} description={HIKING.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-mono font-semibold text-black dark:text-white mt-2">
        {HIKING.TITLE}
      </h1>
      <div class="mt-1">
        {HIKING.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div
      id="search-collection-wrapper"
      class="animate"
      style={{ minHeight: `${estimated_initial_size}px` }}
    >
      <SearchCollection
        client:load
        entry_name={"trails"}
        tags={tags}
        data={trails}
      />
    </div>
  </BottomLayout>
</PageLayout>
