---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import StackCard from "@components/StackCard.astro"
import { SITE, SOCIALS } from "@consts"
import Ridgeline from "@components/Ridgeline.astro"
import Sky from "@components/Sky.astro"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const tracks = (await getCollection("music"))
  .filter(track => !track.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const trails = (await getCollection("hiking"))
  .filter(trail => !trail.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const stack = [
  {
    text: "Astro",
    icon: "astro",
    href: "https://astro.build"
  },
  {
    text: "Javascript",
    icon: "javascript",
    href: "https://www.javascript.com"
  },
  {
    text: "Typescript",
    icon: "typescript",
    href: "https://www.typescriptlang.org"
  },
  {
    text: "Tailwind",
    icon: "tailwind",
    href: "https://tailwindcss.com"
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <div class="topo-field"></div>

  <!-- HERO -->
  <section class="relative h-screen w-full overflow-hidden">
    <Sky />
    <Ridgeline />
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center font-mono'>
          <p class='animated text-sm md:text-base opacity-60'>
            <span class="prompt">whoami</span>
          </p>
          <p class='animated text-2xl md:text-3xl lg:text-4xl font-bold text-black dark:text-white mt-1'>
            noé steiner<span class="cursor"></span>
          </p>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75 mt-3'>
            Software Engineer @ Infomaniak | The Ethical Cloud 🇨🇭
          </p>
          <p class='animated text-xs md:text-sm mt-1'>
            <span class="text-ice-600 dark:text-ice-300">infra &amp; go</span>
            <span class="opacity-30 mx-1">·</span>
            <span class="text-moss-600 dark:text-moss-400">FL Studio</span>
            <span class="opacity-30 mx-1">·</span>
            <span class="opacity-70">alpine trails</span>
          </p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-6'>
            <a href='/blog' class='py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend'>
              Read my blog
            </a>
            <a href='/work' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              View my work
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">

      <!-- About Section -->
      <section class="animate">
        <article>
          <p>I'm a <b><i>Software Engineer</i></b> specialized in cloud infrastructure. I currently work at <b><i>Infomaniak | The Ethical Cloud 🇨🇭</i></b>, building Kubernetes operators, Terraform/OpenTofu providers, and Go microservices for cloud-native systems that try to stay both reliable and honest about how they handle your data.</p>

          <p>Most of my day is <b><i>Go</i></b>, <b><i>Kubernetes</i></b>, and infrastructure-as-code — the kind of work where the win condition is "nobody noticed anything happened." I like systems that are boring in production and interesting to build.</p>

          <p>Outside of a terminal, I'm usually in one of two places: FL Studio, layering synths and field recordings into whatever genre I'm currently obsessed with, or somewhere above 2,000 meters in the Alps with a camera, chasing a ridgeline before the light changes. Both ended up with their own sections on this site — see <a href="/music">Music</a> and <a href="/hiking">Trails</a>.</p>

          <p>This blog is where the three overlap: infra write-ups, project notes, the occasional track, and trip reports from wherever I hiked last.</p>
        </article>
      </section>

      <!-- Blog Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-mono font-semibold text-black dark:text-white">
              /recent_posts
            </p>
            <a href="/blog" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All posts
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Music Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-mono font-semibold text-black dark:text-white">
              /recent_tracks
            </p>
            <a href="/music" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All tracks
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {tracks.map((track) => (
              <li>
                <ArrowCard entry={track} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Project Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-mono font-semibold text-black dark:text-white">
              /recent_projects
            </p>
            <a href="/projects" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All projects
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Trails Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-mono font-semibold text-black dark:text-white">
              /recent_trails
            </p>
            <a href="/hiking" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All trails
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {trails.map((trail) => (
              <li>
                <ArrowCard entry={trail} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Tech Stack Section -->
      <section class="animate">
        <div class="space-y-4">
          <p class="font-mono font-semibold text-black dark:text-white">
            /built_with
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-5">
            {stack.map(item => (
              <StackCard
                text={item.text}
                icon={item.icon}
                href={item.href}
              />
            ))}
          </div>
          <div>
            Performing reactivity and statefulness, special guest
            <a href="https://www.solidjs.com/" target="_blank" class="w-fit group underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                SolidJS
              </span>
            </a>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="animate">
        <div>
          <p class="font-mono font-semibold text-black dark:text-white">
            /lets_connect
          </p>
          <p>
            Reach out to me via email or on social media.
          </p>
          <div class="grid grid-cols-4 gap-y-2 mt-4 auto-cols-min">
            {SOCIALS.map(social => (
              <div class="col-span-1 flex items-center gap-1">
                <span class="whitespace-nowrap truncate">
                  {social.NAME}
                </span>
              </div>
              <div class="col-span-3 truncate">
                <a href={social.HREF} target="_blank" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
                  <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                    {social.TEXT}
                  </span>
                </a>
              </div>
            ))}
        </div>
      </section>
    </div>
  </div>
</PageLayout>
