---
import { getLocalizedCollection } from "@lib/i18n-content"
import LegalArticleBody from "@components/pages/LegalArticleBody.astro"

export async function getStaticPaths() {
  const docs = await getLocalizedCollection("legal", "en")
  return docs.map((doc) => ({
    params: { slug: doc.realSlug },
    props: doc,
  }))
}

const doc = Astro.props
---

<LegalArticleBody doc={doc} />
