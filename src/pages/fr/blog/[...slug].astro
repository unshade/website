---
import { getLocalizedCollection } from "@lib/i18n-content"
import CollectionArticleBody from "@components/pages/CollectionArticleBody.astro"

export async function getStaticPaths() {
  const posts = await getLocalizedCollection("blog", "fr")
  return posts.map((post) => ({
    params: { slug: post.realSlug },
    props: post,
  }))
}

const entry = Astro.props
---

<CollectionArticleBody entry={entry} />
