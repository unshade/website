---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import SearchCollection from "@components/SearchCollection";
import { MUSIC } from "@consts";

const tracks = (await getCollection("music"))
  .filter((track) => !track.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [...new Set(tracks.flatMap((track) => track.data.tags))].sort(
  (a, b) => a.localeCompare(b),
);

const estimated_initial_size =
  28 + tracks.length * 158 + (tracks.length - 1) * 12;
---

<PageLayout title={MUSIC.TITLE} description={MUSIC.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-mono font-semibold text-black dark:text-white mt-2">
        {MUSIC.TITLE}
      </h1>
      <div class="mt-1">
        {MUSIC.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div
      id="search-collection-wrapper"
      class="animate"
      style={{ minHeight: `${estimated_initial_size}px` }}
    >
      <SearchCollection
        client:load
        entry_name={"tracks"}
        tags={tags}
        data={tracks}
      />
    </div>
  </BottomLayout>
</PageLayout>
